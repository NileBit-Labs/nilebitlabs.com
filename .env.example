# SMTP configuration for the project inquiry form. Never commit real credentials.
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=587
CONTACT_SMTP_USER=website@example.com
CONTACT_SMTP_PASS=replace-with-a-secret
CONTACT_TO_EMAIL=info@nilebitlabs.com
CONTACT_FROM_EMAIL=website@example.com

# NileBot production AI mode. Leave unset to use deterministic fallback mode.
# Use the provider's HTTPS chat-completions-compatible endpoint.
NILEBOT_API_URL=https://api.example.com/v1/chat/completions
NILEBOT_API_KEY=replace-with-a-secret
NILEBOT_MODEL=provider-model-name
